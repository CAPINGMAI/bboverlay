# 一个简单的斜四轴示意模型（给「自定义 OBJ」测试/示例用）
# 用法： --obj 示例模型.obj
# 格式：v x y z / f a b c ...（单位随意，程序会归一化成机身大小）

# 机身（扁盒子）
v -0.45 -0.10 -0.08
v  0.45 -0.10 -0.08
v  0.45  0.10 -0.08
v -0.45  0.10 -0.08
v -0.35 -0.08  0.10
v  0.35 -0.08  0.10
v  0.35  0.08  0.10
v -0.35  0.08  0.10
f 1 2 3
f 1 3 4
f 5 6 7
f 5 7 8
f 1 2 6
f 1 6 5
f 2 3 7
f 2 7 6
f 3 4 8
f 3 8 7
f 4 1 5
f 4 5 8

# 左前臂
v -0.40  0.06  0.00
v -1.10  0.70  0.00
v -1.10  0.52  0.00
v -0.40 -0.02  0.00
f 9 10 11
f 9 11 12

# 右前臂
v 0.40  0.06  0.00
v 1.10  0.70  0.00
v 1.10  0.52  0.00
v 0.40 -0.02  0.00
f 13 15 14
f 13 16 15

# 左后臂
v -0.40 -0.06  0.00
v -1.05 -0.70  0.00
v -1.05 -0.52  0.00
v -0.40  0.02  0.00
f 17 18 19
f 17 19 20

# 右后臂
v 0.40 -0.06  0.00
v 1.05 -0.70  0.00
v 1.05 -0.52  0.00
v 0.40  0.02  0.00
f 21 23 22
f 21 24 23